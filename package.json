{
  "name": "dsh-mcp-manager",
  "description": "DeepSeek Harness (DSH) 插件：管理 MCP 服务器，支持 STDIO / HTTP·SSE / OpenAPI 服务，连接后自动将工具同步注册到对话环境中；提供现代化的设置页可视化管理面板。",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dong152389/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/dong152389/dsh-mcp-manager#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.2.0",
      "dshReleases": {
        "rc.7": "incompatible",
        "rc.8": "incompatible",
        "0.1.1-rc.1": "incompatible",
        "0.1.1-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs"
  ],
  "keywords": [
    "cordis",
    "dsh",
    "mcp",
    "model-context-protocol",
    "openapi"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2"
  },
  "scripts": {
    "build:formal": "node scripts/build-formal.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm test && npm run build:formal"
  }
}
