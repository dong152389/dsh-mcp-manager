{
  "name": "dsh-mcp-manager",
  "description": "DeepSeek Harness (DSH) 插件：管理 MCP 服务器，支持 STDIO / HTTP·SSE / OpenAPI 服务，连接后自动将工具同步注册到对话环境中；提供现代化的设置页可视化管理面板。",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "cordis",
    "dsh",
    "mcp",
    "model-context-protocol",
    "openapi"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2"
  },
  "scripts": {
    "build:formal": "node scripts/build-formal.mjs",
    "test:bridge": "node test/mock-server.js"
  }
}
